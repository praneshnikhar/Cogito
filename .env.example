# ============================================================================
# Cogito — environment template. Copy to `.env` and fill in what you have.
# EVERYTHING has a working default: the stack runs fully offline with the
# built-in "local" provider and fallback retrieval. Cloud keys just light up
# the corresponding feature.
# ============================================================================

# ---------- Core runtime ----------
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
COGITO_ENV=production

# ---------- MongoDB (primary store) ----------
MONGODB_URI=mongodb://mongodb:27017/cogito?replicaSet=rs0&directConnection=true
MONGODB_DB=cogito

# Real Mongo Atlas connection (optional; overrides MONGODB_URI when set)
# ATLAS_URI=mongodb+srv://user:pass@cluster.mongodb.net/cogito

# ---------- LLM & Embeddings -------------
# Provider choices: openrouter | openai | ollama | local
LLM_PROVIDER=local
LLM_MODEL=deepseek/deepseek-chat
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=qwen2.5:7b

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---------- Telemetry (no-op without keys) ----------
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_DISTINCT_ID=cogito-demo
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# ---------- Upstash / Redis (rate limiting + cache) ----------
REDIS_URL=redis://redis:6379/0
# UPSTASH_REDIS_REST_URL=   # real Upstash overrides REDIS_URL when set
# UPSTASH_REDIS_REST_TOKEN=

# ---------- Pinecone (secondary vector comparison store) ----------
PINECONE_API_KEY=
PINECONE_ENV=us-east4-gcp
PINECONE_INDEX=cogito

# ---------- Supabase (auth + analytics mirror) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Local Postgres mirror (Supabase-compatible) used when SUPABASE_URL is empty
POSTGRES_DSN=postgresql+asyncpg://cogito:cogito@postgres:5432/cogito

# ---------- Agents & search ----------
AGENT_MAX_ITERATIONS=3
RETRIEVAL_TOP_K=5
SEARCH_NUM_CANDIDATES=100
EVALUATION_ENABLED=true

# ---------- n8n webhook (automation entrypoint) ----------
# COGITO_ADMIN_TOKEN=change-me  # sent as X-Admin-Token by n8n workflows
COGITO_WEBHOOK_URL=http://backend:8000/webhooks/ingest
N8N_WEBHOOK_URL=http://n8n:5678/webhook/cogito-ingest

# ---------- App ----------
CORS_ORIGINS=*
ADMIN_TOKEN=change-me