# Web (frontend) env — point the UI at your FastAPI backend.
# Copy to web/.env.local
NEXT_PUBLIC_COGITO_API=http://localhost:8000

# Server-side token used by /api/documents proxies for write routes.
# Must match ADMIN_TOKEN in the root .env (default: change-me).
COGITO_ADMIN_TOKEN=change-me

# For real deployments put the backend behind a URL, e.g.
# NEXT_PUBLIC_COGITO_API=https://cogito-api.onrender.com
# NEXT_PUBLIC_SENTRY_DSN=
